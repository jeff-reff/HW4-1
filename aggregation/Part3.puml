@startuml
'https://plantuml.com/class-diagram

class Course {
    - name: String
    - instructors: ArrayList<Instructor>
    - textbooks: ArrayList<Textbook>

    + Course()
    + getName(): String
    + setName(name: String): void
    + getInstructors(): ArrayList<Instructor>
    + setInstructors(instructor: Instructor): void
    + getTextbooks(): ArrayList<Textbook>
    + setTexbooks(textbook: Textbook): void
    + toString(): String
    + print(): void
}

class Instructor{
    - firstName: String
    - lastName: String
    - officeNum: String

    + Instructor(firstName: String, lastName: String, officeNum: String)
    + getFirstName(): String
    + setFirstName(firstName: String): void
    + getLastName(): String
    + setLastName(lastName: String): void
    + getOfficeNum(): String
    + setOfficeNum(officeNum: String): void
    + toString(): String
}

class Textbook{
    - title: String
    - author: String
    - publisher: String

    + Textbook(title: String, author: String, publisher: String)
    + getTitle(): String
    + setTitle(title: String): void
    + getAuthor(): String
    + setAuthor(author: String): void
    + getPublisher(): String
    + setPublisher(publisher: String): void
    + toString(): String
}

class Driver{
    + main(args: String[]): void
}

Course o-- Textbook
Course o-- Instructor

Driver ..> Course
Driver ..> Textbook
Driver ..> Instructor

@enduml